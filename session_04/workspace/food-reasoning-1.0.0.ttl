@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix food: <https://example.org/food-kr/schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/food-kr/ontology> a owl:Ontology ;
    rdfs:label "Food Knowledge Representation Ontology"@en ;
    dcterms:description "An OWL ontology for representing branded food products, ingredient concepts, and sesame declaration candidates. It supports semantic reasoning about ingredient declarations while distinguishing declared ingredients from verified product composition."@en ;
    dcterms:title "Food Knowledge Representation Ontology"@en ;
    owl:versionIRI <https://example.org/food-kr/ontology/1.0.0> ;
    owl:versionInfo "1.0.0" .

food:SesameDeclarationCandidate a owl:Class ;
    rdfs:label "Sesame declaration candidate"@en ;
    IAO:0000115 "A branded food product for which the modeled ingredient declarations include at least one ingredient classified as sesame. This classification identifies a declaration-based candidate and does not independently verify the product's composition."@en ;
    rdfs:subClassOf food:BrandedFood ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( food:BrandedFood [ a owl:Restriction ;
                        owl:onProperty food:hasDeclaredIngredient ;
                        owl:someValuesFrom food:SesameIngredient ] ) ] ;
    skos:definition "A branded food product for which the modeled ingredient declarations include at least one ingredient classified as sesame. This classification identifies a declaration-based candidate and does not independently verify the product's composition."@en .

food:Food a owl:Class ;
    rdfs:label "Food"@en ;
    IAO:0000115 "A food entity represented in the knowledge representation system."@en ;
    skos:definition "A food entity represented in the knowledge representation system."@en .

food:SesameIngredient a owl:Class ;
    rdfs:label "Sesame ingredient"@en ;
    IAO:0000115 "An ingredient concept classified as sesame for declaration-based food reasoning."@en ;
    rdfs:subClassOf food:Ingredient ;
    skos:definition "An ingredient concept classified as sesame for declaration-based food reasoning."@en .

food:hasDeclaredIngredient a owl:ObjectProperty ;
    rdfs:label "has declared ingredient"@en ;
    IAO:0000115 "Relates a branded food product to an ingredient represented in its ingredient declaration."@en ;
    rdfs:domain food:BrandedFood ;
    rdfs:range food:Ingredient ;
    skos:definition "Relates a branded food product to an ingredient represented in its ingredient declaration."@en .

food:Ingredient a owl:Class ;
    rdfs:label "Ingredient"@en ;
    IAO:0000115 "An ingredient concept that may be referenced in the declaration of a branded food product."@en ;
    skos:definition "An ingredient concept that may be referenced in the declaration of a branded food product."@en .

food:BrandedFood a owl:Class ;
    rdfs:label "Branded food"@en ;
    IAO:0000115 "A food product represented as a branded food item in the knowledge representation system."@en ;
    rdfs:subClassOf food:Food ;
    skos:definition "A food product represented as a branded food item in the knowledge representation system."@en .

