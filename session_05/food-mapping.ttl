
@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix food: <https://example.org/food-kr/schema#> .

#################################################################
# 1. FOOD PRODUCTS
#################################################################

<#Foods>
    rr:logicalTable [
        rr:sqlQuery """
            SELECT
                NULLIF(TRIM(fdc_id), '') AS fdc_id,
                NULLIF(TRIM(description), '') AS description
            FROM food
            WHERE NULLIF(TRIM(fdc_id), '') IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template
            "https://example.org/food-kr/id/food/usda/{fdc_id}" ;
        rr:class food:Food
    ] ;

    rr:predicateObjectMap [
        rr:predicate food:description ;
        rr:objectMap [
            rr:column "description" ;
            rr:datatype xsd:string
        ]
    ] .


#################################################################
# 2. BRANDED FOOD PRODUCTS - CLASS MEMBERSHIP
#################################################################

<#BrandedFoods>
    rr:logicalTable [
        rr:sqlQuery """
            SELECT TRIM(fdc_id) AS fdc_id
            FROM branded_food
            WHERE NULLIF(TRIM(fdc_id), '') IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template
            "https://example.org/food-kr/id/food/usda/{fdc_id}" ;
        rr:class food:BrandedFood
    ] .


#################################################################
# 3. INGREDIENT DECLARATIONS
# Exclude products with missing ingredient declarations.
#################################################################

<#IngredientDeclarations>
    rr:logicalTable [
        rr:sqlQuery """
            SELECT
                TRIM(fdc_id) AS fdc_id,
                TRIM(ingredients) AS ingredients
            FROM branded_food
            WHERE NULLIF(TRIM(fdc_id), '') IS NOT NULL
              AND NULLIF(TRIM(ingredients), '') IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template
            "https://example.org/food-kr/id/food/usda/{fdc_id}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate food:ingredientDeclaration ;
        rr:objectMap [
            rr:column "ingredients" ;
            rr:datatype xsd:string
        ]
    ] .


