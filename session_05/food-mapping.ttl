#################################################################
# 8. NUTRIENT DEFINITIONS
#################################################################

<#Nutrients>
    rr:logicalTable [
        rr:sqlQuery """
            SELECT
                NULLIF(TRIM(id), '') AS id,
                NULLIF(TRIM(name), '') AS name,
                NULLIF(TRIM(unit_name), '') AS unit_name
            FROM nutrient
            WHERE NULLIF(TRIM(id), '') IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template
            "https://example.org/food-kr/id/nutrient/usda/{id}" ;
        rr:class food:Nutrient
    ] ;

    rr:predicateObjectMap [
        rr:predicate food:nutrientName ;
        rr:objectMap [
            rr:column "name" ;
            rr:datatype xsd:string
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate food:unitName ;
        rr:objectMap [
            rr:column "unit_name" ;
            rr:datatype xsd:string
        ]
    ] .


#################################################################
# 9. NUTRIENT MEASUREMENTS
#################################################################

<#NutrientMeasurements>
    rr:logicalTable [
        rr:sqlQuery """
            SELECT
                NULLIF(TRIM(id), '') AS id,
                NULLIF(TRIM(fdc_id), '') AS fdc_id,
                NULLIF(TRIM(nutrient_id), '') AS nutrient_id,
                NULLIF(TRIM(amount), '') AS amount
            FROM food_nutrient
            WHERE NULLIF(TRIM(id), '') IS NOT NULL
              AND NULLIF(TRIM(fdc_id), '') IS NOT NULL
              AND NULLIF(TRIM(nutrient_id), '') IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template
            "https://example.org/food-kr/id/measurement/usda/{id}" ;
        rr:class food:NutrientMeasurement
    ] ;

    rr:predicateObjectMap [
        rr:predicate food:measuresNutrient ;
        rr:objectMap [
            rr:template
                "https://example.org/food-kr/id/nutrient/usda/{nutrient_id}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate food:amount ;
        rr:objectMap [
            rr:column "amount" ;
            rr:datatype xsd:decimal
        ]
    ] .


#################################################################
# 10. FOOD -> NUTRIENT MEASUREMENT RELATIONSHIPS
#################################################################

<#FoodMeasurementLinks>
    rr:logicalTable [
        rr:sqlQuery """
            SELECT
                NULLIF(TRIM(id), '') AS id,
                NULLIF(TRIM(fdc_id), '') AS fdc_id
            FROM food_nutrient
            WHERE NULLIF(TRIM(id), '') IS NOT NULL
              AND NULLIF(TRIM(fdc_id), '') IS NOT NULL
              AND NULLIF(TRIM(nutrient_id), '') IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template
            "https://example.org/food-kr/id/food/usda/{fdc_id}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate food:hasNutrientMeasurement ;
        rr:objectMap [
            rr:template
                "https://example.org/food-kr/id/measurement/usda/{id}"
        ]
    ] .
