#################################################################
# 7. GTIN / UPC IDENTIFIERS
#################################################################

<#GtinUpcs>
    rr:logicalTable [
        rr:sqlQuery """
            SELECT
                TRIM(fdc_id) AS fdc_id,
                TRIM(gtin_upc) AS gtin_upc
            FROM branded_food
            WHERE NULLIF(TRIM(fdc_id), '') IS NOT NULL
              AND NULLIF(TRIM(gtin_upc), '') IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template
            "https://example.org/food-kr/id/food/usda/{fdc_id}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate food:gtinUpc ;
