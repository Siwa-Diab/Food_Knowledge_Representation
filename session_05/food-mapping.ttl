        rr:sqlQuery """
            SELECT
                TRIM(fdc_id) AS fdc_id,
                TRIM(branded_food_category) AS branded_food_category
            FROM branded_food
            WHERE NULLIF(TRIM(fdc_id), '') IS NOT NULL
              AND NULLIF(TRIM(branded_food_category), '') IS NOT NULL
        """
    ] ;

    rr:subjectMap [
        rr:template
            "https://example.org/food-kr/id/food/usda/{fdc_id}"
